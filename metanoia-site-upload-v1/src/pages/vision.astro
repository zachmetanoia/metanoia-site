---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Section from "@/components/Section.astro";
import { coreValues } from "@/data/site";
---

<BaseLayout
  title="Vision"
  description="A generation of university students so renewed in mind by the Gospel that they rise as the Ekklesia of Jesus."
>
  <PageHero
    eyebrow="Vision & Mission"
    title="A generation renewed, established, and sent."
    lede="We believe the university years are some of the most formative of a person's life — and one of the greatest mission fields in the world."
  />

  <Section tone="warm">
    <div class="grid gap-14 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-semibold text-gold">Vision</h2>
        <p class="prose-body mt-4 text-lg">
          A generation of university students so renewed in mind by the Gospel that they rise as
          the Ekklesia of Jesus — reformers who carry the culture of God's Kingdom into every
          sphere of society.
        </p>
        <p class="prose-body mt-4">
          Students who don't compartmentalize their faith from their studies, but who let Christ
          renew how they think about everything — their major, their calling, their
          relationships, their money, their future — so that when they graduate, they are not
          merely "Christians with a degree," but reformers sent into their sphere of society
          carrying the Kingdom of God with them.
        </p>
      </div>
      <div>
        <h2 class="text-2xl font-semibold text-gold">Mission</h2>
        <p class="prose-body mt-4 text-lg">
          METANOIA exists to <strong>RENEW</strong> the minds of Christian students through the
          Gospel, <strong>ESTABLISH</strong> them in the culture and power of God's Kingdom, and
          <strong>SEND</strong> them out as reformers of society — the Ekklesia of Jesus in the
          university and beyond.
        </p>
        <p class="prose-body mt-4">
          We do this the way Jesus did it: not through a classroom, but through a small group of
          ordinary people who walked closely with Him for an extended season, watched how He
          lived, were released to practice what they were learning, and were ultimately sent out
          to reproduce everything they had received in others.
        </p>
      </div>
    </div>
  </Section>

  <Section tone="midnight">
    <div class="max-w-3xl">
      <p class="eyebrow mb-4 text-gold">Rooted in Scripture</p>
      <blockquote class="border-l-4 border-gold pl-6 text-xl italic leading-relaxed text-warm-white/90 sm:text-2xl">
        "Do not be conformed to this world, but be transformed by the
        <span class="font-semibold not-italic text-gold">renewing of your mind</span>, that by
        testing you may discern what is the will of God, what is good and acceptable and
        perfect." <cite class="mt-3 block text-sm font-semibold not-italic text-warm-white/60">Romans 12:2</cite>
      </blockquote>
      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-warm-white/70">
        This renewing is METANOIA — the same change of mind Scripture calls for in Acts 3:19 and
        Romans 2:4. A renewed mind is what a true change of mind produces. This is the one thing
        our whole program exists to do: not add religious activity to a student's life, but renew
        the mind, because a renewed mind produces a transformed life.
      </p>
    </div>
  </Section>

  <Section tone="warm">
    <div class="mb-10 max-w-2xl">
      <p class="eyebrow mb-3">What we hold onto</p>
      <h2 class="text-3xl font-semibold sm:text-4xl">Core Values</h2>
    </div>
    <ul class="grid gap-x-10 gap-y-4 sm:grid-cols-2">
      {
        coreValues.map((value) => (
          <li class="flex gap-3 text-sm leading-relaxed text-midnight/85">
            <span class="mt-0.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true" />
            <span>{value}</span>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
