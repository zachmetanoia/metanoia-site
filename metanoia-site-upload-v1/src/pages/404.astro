---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout title="Page Not Found">
  <Section tone="warm" class="min-h-[60vh] flex items-center">
    <div class="max-w-lg">
      <p class="eyebrow mb-4">404</p>
      <h1 class="text-4xl font-semibold">This page doesn't exist.</h1>
      <p class="prose-body mt-4">
        The page you're looking for may have moved. Let's get you back on track.
      </p>
      <Button href="/" class="mt-6">Back to Home</Button>
    </div>
  </Section>
</BaseLayout>
