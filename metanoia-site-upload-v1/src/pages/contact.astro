---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Section from "@/components/Section.astro";
import Button from "@/components/Button.astro";
import { site } from "@/data/site";
---

<BaseLayout title="Contact" description="Get in touch with the METANOIA team.">
  <PageHero
    eyebrow="Contact"
    title="We'd love to hear from you."
    lede="Questions about applying, partnering, or bringing METANOIA to your university — reach out any way that's easiest."
  />

  <Section tone="warm">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      <div class="rounded-2xl border border-midnight/10 bg-pure-white p-7">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-gold">Email</h2>
        <p class="mt-3 text-lg font-medium">
          <a href={`mailto:${site.email}`} class="hover:text-gold">{site.email}</a>
        </p>
        <p class="mt-2 text-sm text-midnight/70">We typically reply within a couple of days.</p>
      </div>

      {
        site.socials.whatsapp && (
          <div class="rounded-2xl border border-midnight/10 bg-pure-white p-7">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-gold">WhatsApp Community</h2>
            <p class="mt-3 text-sm text-midnight/70">
              Join the community group for announcements and quick questions.
            </p>
            <Button href={site.socials.whatsapp} external class="mt-4">
              Join on WhatsApp
            </Button>
          </div>
        )
      }

      {
        site.socials.instagram && (
          <div class="rounded-2xl border border-midnight/10 bg-pure-white p-7">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-gold">Instagram</h2>
            <p class="mt-3 text-sm text-midnight/70">Follow along for updates and stories.</p>
            <Button href={site.socials.instagram} external class="mt-4">
              @metanoia
            </Button>
          </div>
        )
      }
    </div>

    <div class="mt-14 rounded-3xl bg-midnight px-8 py-12 text-warm-white sm:px-14">
      <h2 class="text-2xl font-semibold sm:text-3xl">Want METANOIA at your university?</h2>
      <p class="mt-3 max-w-xl text-warm-white/80">
        Part of the vision from day one is multiplying into new cities and universities. If you're
        interested in helping plant a cohort, we'd love to talk.
      </p>
      <Button href={`mailto:${site.email}?subject=Planting%20METANOIA`} variant="primary" class="mt-6">
        Email the Team
      </Button>
    </div>
  </Section>
</BaseLayout>
