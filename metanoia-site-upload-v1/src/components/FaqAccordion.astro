---
import type { FaqItem } from "@/data/site";

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<!--
  Uses native <details>/<summary> — accessible, keyboard-operable, and
  works with zero JavaScript.
-->
<div class="divide-y divide-midnight/10 border-y border-midnight/10">
  {
    items.map((item) => (
      <details class="group py-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-base font-semibold text-midnight marker:content-none">
          <span>{item.question}</span>
          <span
            aria-hidden="true"
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-midnight/20 text-lg leading-none text-midnight transition-transform group-open:rotate-45"
          >
            +
          </span>
        </summary>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-midnight/75">{item.answer}</p>
      </details>
    ))
  }
</div>
